{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "unitId",
    "topic",
    "goal",
    "english",
    "vietnamese",
    "hint",
    "model",
    "source",
    "modelProvenance",
    "scaffold"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "unitId": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "english": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "vietnamese": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "hint": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "model": {
      "type": "string",
      "maxLength": 10000,
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "book",
        "section",
        "task",
        "printedPage",
        "pdfPage",
        "origin",
        "adaptation"
      ],
      "properties": {
        "book": {
          "const": "global-success-11-third-reprint"
        },
        "section": {
          "const": "IV Speaking"
        },
        "task": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 1
        },
        "printedPage": {
          "type": "integer",
          "minimum": 1
        },
        "pdfPage": {
          "type": "integer",
          "minimum": 1
        },
        "origin": {
          "enum": [
            "source",
            "adapted",
            "authored"
          ]
        },
        "adaptation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "modelProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "note"
      ],
      "properties": {
        "origin": {
          "enum": [
            "source",
            "adapted",
            "authored"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 1
        }
      }
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keywords",
        "frame",
        "origin",
        "frameAnswers"
      ],
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frame": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "const": "authored"
        },
        "frameAnswers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
